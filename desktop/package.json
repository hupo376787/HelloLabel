{
  "name": "hellolabel-desktop",
  "version": "0.2.12",
  "description": "HelloLabel desktop shell",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": {
    "electron": "37.2.6",
    "electron-builder": "26.15.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.hellolabel.desktop",
    "productName": "HelloLabel",
    "asar": true,
    "directories": {
      "output": "../dist/desktop",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "build/icon.png",
      "build/icon.ico",
      "build/icon.icns",
      "build/icons/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-dist/HelloLabelServer",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "icon": "build/icons",
      "desktopName": "hellolabel.desktop"
    }
  }
}
